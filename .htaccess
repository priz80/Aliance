# Включаем движок переписывания URL
RewriteEngine On

# 1. Если запрошенный файл существует физически (например, image.jpg, style.css),
#    не трогаем его, отдаем как есть.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Если запрошенная директория существует физически,
#    не трогаем её.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Если файл И директория НЕ найдены, перенаправляем запрос на 404.php
#    [L] означает "Last Rule" — останавливать дальнейшую обработку, если правило сработало.
RewriteRule ^ /404.php [L]

# На всякий случай, добавляем обработчик ошибки (для старых случаев или внутренних редиректов)
ErrorDocument 404 /404.php